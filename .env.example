POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar@db:5432/jobradar
API_KEY=change-me-local
APP_TIMEZONE=UTC
DAILY_INGEST_HOUR=7
DAILY_INGEST_MINUTE=0
SCAN_ON_STARTUP=true
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
MAX_CONCURRENT_SOURCES=5
ALLOW_UNCLEAR_LANGUAGE=false
LOG_LEVEL=INFO

# Optional local overrides. Keep these in .env (which is gitignored).
CONFIG_DIR_HOST=./config
DATA_DIR_HOST=./data
